-- ══════════════════════════════════════════════════════════════════════
-- PRESET BUTTONS
-- ══════════════════════════════════════════════════════════════════════
local presetButtons = {}
local presetLabels  = {}

local function updatePresetUI()
    for presetName, data in pairs(presetLabels) do
        local isActive = (cfg.activePreset == presetName)
        local color    = data.color

        if isActive then
            data.nameLbl.TextColor3 = color
            data.stroke.Color       = color
            data.stroke.Transparency = 0
            data.stroke.Thickness    = 1.2
        else
            data.nameLbl.TextColor3 = Color3.fromRGB(120,120,130)
            data.stroke.Color       = Color3.fromRGB(80,80,90)
            data.stroke.Transparency = 0.6
            data.stroke.Thickness    = 1.0
        end
    end
end

local function createPresetButtons()
    local yPos = 68
    local btnW = (MAIN_W - 14) / 3 - 4
    local btnH = 18

    local presetColors = {
        LOW  = C.presetLow,
        MED  = C.presetMed,
        HIGH = C.presetHigh,
    }

    for i, presetName in ipairs({"LOW", "MED", "HIGH"}) do
        local xOffset     = 7 + (i - 1) * (btnW + 4)
        local isActive    = (cfg.activePreset == presetName)
        local presetColor = presetColors[presetName]

        local btn = Instance.new("TextButton", mainFrame)
        btn.Size             = UDim2.new(0, btnW, 0, btnH)
        btn.Position         = UDim2.new(0, xOffset, 0, yPos)
        btn.BackgroundColor3 = C.card
        btn.BackgroundTransparency = T.card
        btn.BorderSizePixel  = 0
        btn.AutoButtonColor  = false
        btn.Text             = ""
        btn.ZIndex           = 13
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        local btnStroke = Instance.new("UIStroke", btn)
        btnStroke.Color        = isActive and presetColor or Color3.fromRGB(80,80,90)
        btnStroke.Thickness    = 1.2
        btnStroke.Transparency = isActive and 0 or 0.6

        local nameLbl = Instance.new("TextLabel", btn)
        nameLbl.Size            = UDim2.new(1,0,1,0)
        nameLbl.Position        = UDim2.new(0,0,0,0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text            = presetName
        nameLbl.TextColor3      = isActive and presetColor or Color3.fromRGB(120,120,130)
        nameLbl.Font            = Enum.Font.GothamBlack
        nameLbl.TextSize        = 9
        nameLbl.ZIndex          = 14

        presetButtons[presetName] = btn
        presetLabels[presetName]  = {nameLbl = nameLbl, stroke = btnStroke, btn = btn, color = presetColor}

        btn.MouseEnter:Connect(function()
            if cfg.activePreset ~= presetName then
                tw(btnStroke, {Transparency = 0.2}, 0.1)
                nameLbl.TextColor3 = presetColor
            end
        end)
        btn.MouseLeave:Connect(function()
            if cfg.activePreset ~= presetName then
                tw(btnStroke, {Transparency = 0.6}, 0.1)
                nameLbl.TextColor3 = Color3.fromRGB(120,120,130)
            end
        end)

        btn.MouseButton1Click:Connect(function()
            if cfg.activePreset and presetConfigs[cfg.activePreset] then
                presetConfigs[cfg.activePreset].power    = cfg.power
                presetConfigs[cfg.activePreset].interval = cfg.interval
            end

            cfg.activePreset = presetName
            applyPreset(presetName)
            updatePresetUI()

            if active then
                active = false
                activateGrad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0,C.red1),
                    ColorSequenceKeypoint.new(1,C.purple1),
                })
                activateLbl.Text            = "ACTIVATE"
                activateStroke.Color        = C.red3
                activateStroke.Transparency = 0.4
                statusLbl.Text              = "OFF"
                statusLbl.TextColor3        = C.red
                tw(statusPill, {BackgroundColor3=Color3.fromRGB(60,5,15)}, 0.2)
                mainStroke.Color            = C.red1
                mainStroke.Transparency     = 0.3

                task.wait(0.15)

                active = true
                if not remote then
                    remote = findRemote()
                    if not remote then
                        active = false
                        return
                    end
                end
                activateGrad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0,C.red2),
                    ColorSequenceKeypoint.new(1,C.purple2),
                })
                activateLbl.Text            = "ACTIVATED"
                activateStroke.Color        = C.white
                activateStroke.Transparency = 0
                statusLbl.Text              = "ON"
                statusLbl.TextColor3        = C.green
                tw(statusPill, {BackgroundColor3=Color3.fromRGB(10,40,20)}, 0.2)
                mainStroke.Color            = C.green
                mainStroke.Transparency     = 0.1
                task.spawn(runPingLoop)
            end

            if settingsOpen then
                powerBox.Text    = tostring(cfg.power)
                intervalBox.Text = tostring(cfg.interval)
            end

            saveConfig()
        end)
    end
end

createPresetButtons()

